          "id": "v412",
          "kana": "はたらきます",
          "kanji": "働きます",
          "zh": "工作"
        }
      ],
      "grammar": [
        {
          "pattern": "〜ました",
          "summary": "過去式：把 ます 換成 ました。",
          "detail": "動詞不管怎麼變，前面的部分都不動，只改 ます 這個結尾。食べます → 食べました。這是日文動詞比中文麻煩、但比英文規律的地方。",
          "examples": [
            {
              "jp": "昨日日本語を勉強しました。",
              "zh": "昨天學了日語。"
            },
            {
              "jp": "今朝ご飯を食べました。",
              "zh": "今天早上吃了飯。"
            }
          ]
        },
        {
          "pattern": "〜ません／〜ませんでした",
          "summary": "否定是 ません，過去否定是 ませんでした。",
          "detail": "四個形態一起記最快：ます（現在肯定）、ません（現在否定）、ました（過去肯定）、ませんでした（過去否定）。",
          "examples": [
            {
              "jp": "今日は働きません。",
              "zh": "今天不工作。"
            },
            {
              "jp": "昨日は本を読みませんでした。",
              "zh": "昨天沒有讀書。"
            }
          ]
        },
        {
          "pattern": "時間詞不加助詞",
          "summary": "昨日、今日、毎日 這類詞後面不加 に。",
          "detail": "「昨天」「今天」「每天」這種相對時間的詞，直接放句子前面就好，不用加助詞。但有明確數字的時間（例如 7時）要加 に，那個之後會學。",
          "examples": [
            {
              "jp": "毎日日本語を書きます。",
              "zh": "每天寫日語。"
            },
            {
              "jp": "今晩友達は来ます。",
              "zh": "今晚朋友會來。"
            }
          ]
        }
      ]
    },

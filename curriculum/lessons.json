{
  "version": 1,
  "lessons": [
    {
      "id": 1,
      "title": "我是學生",
      "pattern": "〜は〜です",
      "goal": "能說出自己的身分，也能問對方是誰。",
      "vocab": [
        { "id": "v101", "kana": "わたし", "kanji": "私", "zh": "我" },
        { "id": "v102", "kana": "あなた", "kanji": null, "zh": "你" },
        { "id": "v103", "kana": "がくせい", "kanji": "学生", "zh": "學生" },
        { "id": "v104", "kana": "せんせい", "kanji": "先生", "zh": "老師" },
        { "id": "v105", "kana": "かいしゃいん", "kanji": "会社員", "zh": "公司職員" },
        { "id": "v106", "kana": "いしゃ", "kanji": "医者", "zh": "醫生" },
        { "id": "v107", "kana": "にほんじん", "kanji": "日本人", "zh": "日本人" },
        { "id": "v108", "kana": "たいわんじん", "kanji": "台湾人", "zh": "台灣人" },
        { "id": "v109", "kana": "ともだち", "kanji": "友達", "zh": "朋友" },
        { "id": "v110", "kana": "なまえ", "kanji": "名前", "zh": "名字" },
        { "id": "v111", "kana": "だれ", "kanji": null, "zh": "誰" },
        { "id": "v112", "kana": "さん", "kanji": null, "zh": "先生／小姐（接在人名後）" }
      ],
      "grammar": [
        {
          "pattern": "〜は〜です",
          "summary": "「A は B です」就是「A 是 B」。",
          "detail": "は 當助詞的時候唸作 わ，不唸 は，這是第一個要記住的例外。です 是禮貌體的句尾，對不熟的人、長輩講話都用它。主語很清楚的時候，日文常把「私は」整個省略掉。",
          "examples": [
            { "jp": "私は学生です。", "zh": "我是學生。" },
            { "jp": "田中さんは先生です。", "zh": "田中先生是老師。" },
            { "jp": "私は台湾人です。", "zh": "我是台灣人。" }
          ]
        },
        {
          "pattern": "〜は〜じゃありません",
          "summary": "否定：把 です 換成 じゃありません。",
          "detail": "正式場合會寫 ではありません，日常講話用 じゃありません 就可以。",
          "examples": [
            { "jp": "私は日本人じゃありません。", "zh": "我不是日本人。" },
            { "jp": "田中さんは医者じゃありません。", "zh": "田中先生不是醫生。" }
          ]
        },
        {
          "pattern": "〜は〜ですか",
          "summary": "疑問：句尾加 か，語序完全不用改。",
          "detail": "日文問句不需要問號，か 本身就等於問號。回答用 はい（是）或 いいえ（不是）。",
          "examples": [
            { "jp": "あなたは学生ですか。", "zh": "你是學生嗎？" },
            { "jp": "田中さんは会社員ですか。", "zh": "田中先生是公司職員嗎？" }
          ]
        }
      ]
    },
    {
      "id": 2,
      "title": "這個是什麼",
      "pattern": "これ・それ・あれ／〜の〜",
      "goal": "能指著東西問「這是什麼」，也能說「這是我的書」。",
      "vocab": [
        { "id": "v201", "kana": "これ", "kanji": null, "zh": "這個（靠近自己）" },
        { "id": "v202", "kana": "それ", "kanji": null, "zh": "那個（靠近對方）" },
        { "id": "v203", "kana": "あれ", "kanji": null, "zh": "那個（離兩人都遠）" },
        { "id": "v204", "kana": "ほん", "kanji": "本", "zh": "書" },
        { "id": "v205", "kana": "かばん", "kanji": null, "zh": "包包" },
        { "id": "v206", "kana": "とけい", "kanji": "時計", "zh": "時鐘、手錶" },
        { "id": "v207", "kana": "かさ", "kanji": "傘", "zh": "傘" },
        { "id": "v208", "kana": "つくえ", "kanji": "机", "zh": "桌子" },
        { "id": "v209", "kana": "いす", "kanji": "椅子", "zh": "椅子" },
        { "id": "v210", "kana": "くるま", "kanji": "車", "zh": "車" },
        { "id": "v211", "kana": "なに", "kanji": "何", "zh": "什麼（接 です 時唸 なん）" },
        { "id": "v212", "kana": "にほんご", "kanji": "日本語", "zh": "日語" }
      ],
      "grammar": [
        {
          "pattern": "これ・それ・あれ",
          "summary": "依「離誰比較近」分成三個，不是中文的「這／那」兩分法。",
          "detail": "これ 是靠近自己的東西，それ 是靠近對方的東西，あれ 是離兩個人都遠的東西。中文只有「這」和「那」，所以 それ 和 あれ 最容易搞混——關鍵在於「東西在不在對方身邊」。",
          "examples": [
            { "jp": "これは本です。", "zh": "這是書。" },
            { "jp": "それは傘です。", "zh": "那（在你那邊的）是傘。" },
            { "jp": "あれは車です。", "zh": "那（遠處的）是車。" }
          ]
        },
        {
          "pattern": "この・その・あの ＋ 名詞",
          "summary": "後面要直接接名詞時，改用 この／その／あの。",
          "detail": "これ 不能直接接名詞。要說「這本書」必須用 この本，不能說 これ本。這是初學最常犯的錯之一。",
          "examples": [
            { "jp": "この本は私のです。", "zh": "這本書是我的。" },
            { "jp": "その鞄は新しいですか。", "zh": "那個包包是新的嗎？" }
          ]
        },
        {
          "pattern": "〜の〜",
          "summary": "の 把兩個名詞連起來，表示所屬或性質。",
          "detail": "最常見的是「誰的東西」：私の本＝我的書。也可以表示屬性：日本語の本＝日語的書。後面的名詞很明顯時可以省略，直接說 私の（我的）。",
          "examples": [
            { "jp": "これは私の時計です。", "zh": "這是我的手錶。" },
            { "jp": "それは日本語の本です。", "zh": "那是日語的書。" },
            { "jp": "あの椅子は先生のです。", "zh": "那張椅子是老師的。" }
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "我每天讀日文",
      "pattern": "〜を〜ます／〜で〜ます",
      "goal": "能說出自己在做什麼、在哪裡做。",
      "vocab": [
        { "id": "v301", "kana": "たべます", "kanji": "食べます", "zh": "吃" },
        { "id": "v302", "kana": "のみます", "kanji": "飲みます", "zh": "喝" },
        { "id": "v303", "kana": "みます", "kanji": "見ます", "zh": "看" },
        { "id": "v304", "kana": "よみます", "kanji": "読みます", "zh": "讀" },
        { "id": "v305", "kana": "かきます", "kanji": "書きます", "zh": "寫" },
        { "id": "v306", "kana": "べんきょうします", "kanji": "勉強します", "zh": "學習" },
        { "id": "v307", "kana": "いきます", "kanji": "行きます", "zh": "去" },
        { "id": "v308", "kana": "みず", "kanji": "水", "zh": "水" },
        { "id": "v309", "kana": "ごはん", "kanji": "ご飯", "zh": "飯" },
        { "id": "v310", "kana": "がっこう", "kanji": "学校", "zh": "學校" },
        { "id": "v311", "kana": "うち", "kanji": "家", "zh": "家" },
        { "id": "v312", "kana": "まいにち", "kanji": "毎日", "zh": "每天" }
      ],
      "grammar": [
        {
          "pattern": "〜を〜ます",
          "summary": "を 標出動作的對象，動詞放在句尾。",
          "detail": "日文的語序是「主語 → 受詞 → 動詞」，動詞永遠在最後，這跟中文不一樣。を 只當助詞用，唸作 お。",
          "examples": [
            { "jp": "私はご飯を食べます。", "zh": "我吃飯。" },
            { "jp": "毎日日本語を勉強します。", "zh": "我每天學日語。" },
            { "jp": "友達は本を読みます。", "zh": "朋友讀書。" }
          ]
        },
        {
          "pattern": "〜で〜ます",
          "summary": "で 標出動作發生的地點。",
          "detail": "注意 で 是「在哪裡做某事」。後面第 10 課會學到的 に 是「東西存在於哪裡」，兩個不一樣，先記住 で 配動作。",
          "examples": [
            { "jp": "学校で日本語を勉強します。", "zh": "在學校學日語。" },
            { "jp": "家でご飯を食べます。", "zh": "在家吃飯。" }
          ]
        },
        {
          "pattern": "〜へ行きます",
          "summary": "へ 標出移動的方向，唸作 え。",
          "detail": "へ 當助詞時唸 え，不唸 へ——這是繼 は 唸 わ 之後第二個要記的例外。搭配 行きます（去）、来ます（來）這類移動動詞。",
          "examples": [
            { "jp": "私は学校へ行きます。", "zh": "我去學校。" },
            { "jp": "友達は家へ行きます。", "zh": "朋友回家。" }
          ]
        }
      ]
    },
    {
      "id": 4,
      "title": "昨天做了什麼",
      "pattern": "〜ました／〜ませんでした",
      "goal": "能講過去發生的事，也能否定。",
      "vocab": [
        { "id": "v401", "kana": "きのう", "kanji": "昨日", "zh": "昨天" },
        { "id": "v402", "kana": "きょう", "kanji": "今日", "zh": "今天" },
        { "id": "v403", "kana": "あした", "kanji": "明日", "zh": "明天" },
        { "id": "v404", "kana": "けさ", "kanji": "今朝", "zh": "今天早上" },
        { "id": "v405", "kana": "こんばん", "kanji": "今晩", "zh": "今晚" },
        { "id": "v406", "kana": "あさ", "kanji": "朝", "zh": "早上" },
        { "id": "v407", "kana": "ひる", "kanji": "昼", "zh": "中午" },
        { "id": "v408", "kana": "よる", "kanji": "夜", "zh": "晚上" },
        { "id": "v409", "kana": "せんしゅう", "kanji": "先週", "zh": "上週" },
        { "id": "v410", "kana": "こんしゅう", "kanji": "今週", "zh": "這週" },
        { "id": "v411", "kana": "なんじ", "kanji": "何時", "zh": "幾點" },
        { "id": "v412", "kana": "はたらきます", "kanji": "働きます", "zh": "工作" }
      ],
      "grammar": [
        {
          "pattern": "〜ました",
          "summary": "過去式：把 ます 換成 ました。",
          "detail": "動詞不管怎麼變，前面的部分都不動，只改 ます 這個結尾。食べます → 食べました。這是日文動詞比中文麻煩、但比英文規律的地方。",
          "examples": [
            { "jp": "昨日日本語を勉強しました。", "zh": "昨天學了日語。" },
            { "jp": "今朝ご飯を食べました。", "zh": "今天早上吃了飯。" }
          ]
        },
        {
          "pattern": "〜ません／〜ませんでした",
          "summary": "否定是 ません，過去否定是 ませんでした。",
          "detail": "四個形態一起記最快：ます（現在肯定）、ません（現在否定）、ました（過去肯定）、ませんでした（過去否定）。",
          "examples": [
            { "jp": "今日は働きません。", "zh": "今天不工作。" },
            { "jp": "昨日は本を読みませんでした。", "zh": "昨天沒有讀書。" }
          ]
        },
        {
          "pattern": "時間詞不加助詞",
          "summary": "昨日、今日、毎日 這類詞後面不加 に。",
          "detail": "「昨天」「今天」「每天」這種相對時間的詞，直接放句子前面就好，不用加助詞。但有明確數字的時間（例如 7時）要加 に，那個之後會學。",
          "examples": [
            { "jp": "毎日日本語を書きます。", "zh": "每天寫日語。" },
            { "jp": "今晩友達は来ます。", "zh": "今晚朋友會來。" }
          ]
        }
      ]
    },
    {
      "id": 5,
      "title": "這個很好吃",
      "pattern": "い形容詞・な形容詞",
      "goal": "能描述東西，並說出自己的感覺。",
      "vocab": [
        { "id": "v501", "kana": "おおきい", "kanji": "大きい", "zh": "大的" },
        { "id": "v502", "kana": "ちいさい", "kanji": "小さい", "zh": "小的" },
        { "id": "v503", "kana": "あたらしい", "kanji": "新しい", "zh": "新的" },
        { "id": "v504", "kana": "ふるい", "kanji": "古い", "zh": "舊的" },
        { "id": "v505", "kana": "たかい", "kanji": "高い", "zh": "高的、貴的" },
        { "id": "v506", "kana": "やすい", "kanji": "安い", "zh": "便宜的" },
        { "id": "v507", "kana": "おいしい", "kanji": "美味しい", "zh": "好吃的" },
        { "id": "v508", "kana": "おもしろい", "kanji": "面白い", "zh": "有趣的" },
        { "id": "v509", "kana": "しずか", "kanji": "静か", "zh": "安靜的" },
        { "id": "v510", "kana": "きれい", "kanji": "綺麗", "zh": "漂亮的、乾淨的" },
        { "id": "v511", "kana": "げんき", "kanji": "元気", "zh": "有精神的" },
        { "id": "v512", "kana": "ゆうめい", "kanji": "有名", "zh": "有名的" }
      ],
      "grammar": [
        {
          "pattern": "い形容詞",
          "summary": "字尾是 い 的形容詞，可以直接接名詞。",
          "detail": "大きい、新しい、美味しい 都是。放句尾時直接加 です：美味しいです。接名詞時原樣接上：大きい車。注意——這裡的 です 只是禮貌，形容詞本身已經是完整的敘述了。",
          "examples": [
            { "jp": "この本は面白いです。", "zh": "這本書很有趣。" },
            { "jp": "あれは大きい車です。", "zh": "那是很大的車。" },
            { "jp": "その傘は安いです。", "zh": "那把傘很便宜。" }
          ]
        },
        {
          "pattern": "な形容詞",
          "summary": "接名詞時要多一個 な，所以叫な形容詞。",
          "detail": "静か、綺麗、有名 是這一類。放句尾時跟い形容詞一樣加 です：静かです。但接名詞時要加 な：静かな学校。綺麗 和 元気 結尾雖然有 い，卻是な形容詞，這兩個是最常見的陷阱。",
          "examples": [
            { "jp": "この学校は静かです。", "zh": "這所學校很安靜。" },
            { "jp": "あの人は有名な先生です。", "zh": "那個人是有名的老師。" },
            { "jp": "綺麗な時計ですね。", "zh": "好漂亮的手錶啊。" }
          ]
        },
        {
          "pattern": "〜は〜が〜です",
          "summary": "先講主題，再講主題裡的哪個部分怎麼樣。",
          "detail": "は 提出整個主題，が 指出主題底下具體的那一項。例如「日本は電車が新しいです」＝「日本啊，（它的）電車很新」。這個雙助詞句型是日文的特色，中文沒有對應。",
          "examples": [
            { "jp": "この学校は先生が有名です。", "zh": "這所學校的老師很有名。" },
            { "jp": "私は日本語が面白いです。", "zh": "我覺得日語很有趣。" }
          ]
        }
      ]
    }
  ]
}

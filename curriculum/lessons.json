          "kanji": "時計",
          "zh": "時鐘、手錶"
        },
        {
          "id": "v207",
          "kana": "かさ",
          "kanji": "傘",
          "zh": "傘"
        },
        {
          "id": "v208",
          "kana": "つくえ",
          "kanji": "机",
          "zh": "桌子"
        },
        {
          "id": "v209",
          "kana": "いす",
          "kanji": "椅子",
          "zh": "椅子"
        },
        {
          "id": "v210",
          "kana": "くるま",
          "kanji": "車",
          "zh": "車"
        },
        {
          "id": "v211",
          "kana": "なに",
          "kanji": "何",
          "zh": "什麼（接 です 時唸 なん）"
        },
        {
          "id": "v212",
          "kana": "にほんご",
          "kanji": "日本語",
          "zh": "日語"
        }
      ],
      "grammar": [
        {
          "pattern": "これ・それ・あれ",
          "summary": "依「離誰比較近」分成三個，不是中文的「這／那」兩分法。",
          "detail": "これ 是靠近自己的東西，それ 是靠近對方的東西，あれ 是離兩個人都遠的東西。中文只有「這」和「那」，所以 それ 和 あれ 最容易搞混——關鍵在於「東西在不在對方身邊」。",
          "examples": [
            {
              "jp": "これは本です。",
              "zh": "這是書。"
            },
            {
              "jp": "それは傘です。",
              "zh": "那（在你那邊的）是傘。"
            },
            {
              "jp": "あれは車です。",
              "zh": "那（遠處的）是車。"
            }
          ]
        },
        {
          "pattern": "この・その・あの ＋ 名詞",
          "summary": "後面要直接接名詞時，改用 この／その／あの。",
          "detail": "これ 不能直接接名詞。要說「這本書」必須用 この本，不能說 これ本。這是初學最常犯的錯之一。",
          "examples": [
            {
              "jp": "この本は私のです。",
              "zh": "這本書是我的。"
            },
            {
              "jp": "その鞄は新しいですか。",
              "zh": "那個包包是新的嗎？"
            }
          ]
        },
        {
          "pattern": "〜の〜",
          "summary": "の 把兩個名詞連起來，表示所屬或性質。",
          "detail": "最常見的是「誰的東西」：私の本＝我的書。也可以表示屬性：日本語の本＝日語的書。後面的名詞很明顯時可以省略，直接說 私の（我的）。",
          "examples": [
            {
              "jp": "これは私の時計です。",
              "zh": "這是我的手錶。"
            },
            {
              "jp": "それは日本語の本です。",
              "zh": "那是日語的書。"
            },
            {
              "jp": "あの椅子は先生のです。",
              "zh": "那張椅子是老師的。"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "title": "我每天讀日文",
      "pattern": "〜を〜ます／〜で〜ます",
      "goal": "能說出自己在做什麼、在哪裡做。",
      "vocab": [
        {
          "id": "v301",
          "kana": "たべます",
          "kanji": "食べます",
          "zh": "吃"
        },
        {

          "id": "v111",
          "kana": "だれ",
          "kanji": null,
          "zh": "誰"
        },
        {
          "id": "v112",
          "kana": "さん",
          "kanji": null,
          "zh": "先生／小姐（接在人名後）"
        }
      ],
      "grammar": [
        {
          "pattern": "〜は〜です",
          "summary": "「A は B です」就是「A 是 B」。",
          "detail": "は 當助詞的時候唸作 わ，不唸 は，這是第一個要記住的例外。です 是禮貌體的句尾，對不熟的人、長輩講話都用它。主語很清楚的時候，日文常把「私は」整個省略掉。",
          "examples": [
            {
              "jp": "私は学生です。",
              "zh": "我是學生。"
            },
            {
              "jp": "田中さんは先生です。",
              "zh": "田中先生是老師。"
            },
            {
              "jp": "私は台湾人です。",
              "zh": "我是台灣人。"
            }
          ]
        },
        {
          "pattern": "〜は〜じゃありません",
          "summary": "否定：把 です 換成 じゃありません。",
          "detail": "正式場合會寫 ではありません，日常講話用 じゃありません 就可以。",
          "examples": [
            {
              "jp": "私は日本人じゃありません。",
              "zh": "我不是日本人。"
            },
            {
              "jp": "田中さんは医者じゃありません。",
              "zh": "田中先生不是醫生。"
            }
          ]
        },
        {
          "pattern": "〜は〜ですか",
          "summary": "疑問：句尾加 か，語序完全不用改。",
          "detail": "日文問句不需要問號，か 本身就等於問號。回答用 はい（是）或 いいえ（不是）。",
          "examples": [
            {
              "jp": "あなたは学生ですか。",
              "zh": "你是學生嗎？"
            },
            {
              "jp": "田中さんは会社員ですか。",
              "zh": "田中先生是公司職員嗎？"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "title": "這個是什麼",
      "pattern": "これ・それ・あれ／〜の〜",
      "goal": "能指著東西問「這是什麼」，也能說「這是我的書」。",
      "vocab": [

          "zh": "寫"
        },
        {
          "id": "v306",
          "kana": "べんきょうします",
          "kanji": "勉強します",
          "zh": "學習"
        },
        {
          "id": "v307",
          "kana": "いきます",
          "kanji": "行きます",
          "zh": "去"
        },
        {
          "id": "v308",
          "kana": "みず",
          "kanji": "水",
          "zh": "水"
        },
        {
          "id": "v309",
          "kana": "ごはん",
          "kanji": "ご飯",
          "zh": "飯"
        },
        {
          "id": "v310",
          "kana": "がっこう",
          "kanji": "学校",
          "zh": "學校"
        },
        {
          "id": "v311",
          "kana": "うち",
          "kanji": "家",
          "zh": "家"
        },
        {
          "id": "v312",
          "kana": "まいにち",
          "kanji": "毎日",
          "zh": "每天"
        }
      ],
      "grammar": [
        {
          "pattern": "〜を〜ます",
          "summary": "を 標出動作的對象，動詞放在句尾。",
          "detail": "日文的語序是「主語 → 受詞 → 動詞」，動詞永遠在最後，這跟中文不一樣。を 只當助詞用，唸作 お。",
          "examples": [
            {
              "jp": "私はご飯を食べます。",
              "zh": "我吃飯。"
            },
            {
              "jp": "毎日日本語を勉強します。",
              "zh": "我每天學日語。"
            },
            {
              "jp": "友達は本を読みます。",
              "zh": "朋友讀書。"
            }
          ]
        },
        {
          "pattern": "〜で〜ます",
          "summary": "で 標出動作發生的地點。",
          "detail": "注意 で 是「在哪裡做某事」。後面第 10 課會學到的 に 是「東西存在於哪裡」，兩個不一樣，先記住 で 配動作。",
          "examples": [
            {
              "jp": "学校で日本語を勉強します。",
              "zh": "在學校學日語。"
            },
            {
              "jp": "家でご飯を食べます。",
              "zh": "在家吃飯。"
            }
          ]
        },
        {
          "pattern": "〜へ行きます",
          "summary": "へ 標出移動的方向，唸作 え。",
          "detail": "へ 當助詞時唸 え，不唸 へ——這是繼 は 唸 わ 之後第二個要記的例外。搭配 行きます（去）、来ます（來）這類移動動詞。",
          "examples": [
            {
              "jp": "私は学校へ行きます。",
              "zh": "我去學校。"
            },
            {
              "jp": "友達は家へ行きます。",
              "zh": "朋友回家。"
            }
          ]
        }
      ]
    },
